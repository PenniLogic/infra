{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PenniLogic/infra/security/exceptions.schema.json",
  "title": "Expiring, exact-finding security exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "exceptions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "repository", "pattern", "artifact", "reason", "owner", "expires_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "kind": {"enum": ["secret", "advisory"]},
          "repository": {
            "enum": ["PenniLogic/.github", "PenniLogic/docs", "PenniLogic/contracts", "PenniLogic/api", "PenniLogic/ai-service", "PenniLogic/android", "PenniLogic/web", "PenniLogic/admin", "PenniLogic/infra"]
          },
          "pattern": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,95}$"},
          "artifact": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[ -~]+$"},
          "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
          "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    }
  }
}
