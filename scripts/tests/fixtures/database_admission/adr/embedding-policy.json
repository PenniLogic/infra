    "evidence_status": "NOT_PERFORMED_PERSISTENCE_PROHIBITED",
    "required_evidence": [
      {
        "id": "REOPEN-NEED-MINIMISATION",
        "acceptance": "A reproducible value comparison against deterministic-first categorisation and request-local inference meets numeric go/no-go thresholds set before measurement, with a minimal purpose and data/copy inventory."
      },
      {
        "id": "REOPEN-INVERSION-MEMBERSHIP",
        "acceptance": "Security and Privacy review approve a model-specific inversion and membership-inference protocol, adversary capabilities and predeclared disclosure thresholds; measured results meet them without claiming vector encryption or anonymisation eliminates disclosure."
      },
      {
        "id": "REOPEN-TENANCY-PROTECTION",
        "acceptance": "A named store, tenant and network boundary, low-privilege roles, forced row-level security where applicable, grant and cross-purpose denial tests and searchable-field protection are reviewed against ADR-018 without weakening it."
      },
      {
        "id": "REOPEN-MODEL-REINDEX",
        "acceptance": "Exact licensed model, revision, vector dimension and representation are pinned; version changes require a complete verified re-index and atomic serving-generation change, never mixed generations or unreviewed user-data training."
      },
      {
        "id": "REOPEN-RETENTION-ERASURE",
        "acceptance": "Sourced purpose-bound retention and export rules plus verified hard deletion cover vectors, indexes, caches, jobs, replicas, backups and provider copies; post-erasure similarity-query residue and restore tests pass. Crypto-shredding alone is explicitly insufficient."
      },
      {
        "id": "REOPEN-PROVIDER-ECONOMICS",
        "acceptance": "Current model/license and provider retention, training and transfer terms are approved; reproducible dated economics use actual quotes, integer minor units and currency, numeric margin and usage limits and explicit spend approval, not historical research prices."
      },
      {
        "id": "REOPEN-PURPOSE-REVIEW",
        "acceptance": "A new dated protected-merged decision records its real authority and versioned consequences after independent Core, Security, Privacy and affected QA review, preserving conversation/enrichment purpose separation, default-deny sharing and deterministic authoritative arithmetic."
      }
    ]
  },
