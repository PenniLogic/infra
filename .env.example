# PenniLogic local development environment — the variable contract for the Compose stack.
#
# Copy this file to `.env` (git-ignored), or simply run `python scripts/bootstrap.py`, which
# creates `.env` from this file on first run and fills in a generated development password.
# Every value here is a development-only default. Never put a real, shared or production
# credential in this file or in `.env`; `.env` stays on your machine.
#
# Precedence, identical for Docker Compose and the scripts: process environment > .env > default.
# Clients (API, AI service, tools) read the same names to reach the local services.

# --- Docker publish address -----------------------------------------------------------------
# Host IP address the containers publish to. Loopback only by default. Must be an IP literal
# (127.0.0.1 or ::1), not a hostname; scripts/bootstrap.py refuses any non-loopback address
# unless it is run with --allow-non-loopback, and then only if PENNILOGIC_REDIS_PASSWORD is set.
PENNILOGIC_BIND_ADDRESS=127.0.0.1

# --- Postgres 17 (Compose service "postgres") -----------------------------------------------
PENNILOGIC_POSTGRES_HOST=127.0.0.1
PENNILOGIC_POSTGRES_PORT=5432
PENNILOGIC_POSTGRES_DATABASE=pennilogic
PENNILOGIC_POSTGRES_USER=pennilogic
# Intentionally blank in the example: python scripts/bootstrap.py generates a random
# development-only value when it creates .env (POSIX mode 0600; on Windows the file inherits
# the folder's ACL). If you copy this file by hand, set any development-only value before
# starting. Changing it after the first start does not change the password stored in the data
# volume; `python scripts/bootstrap.py --reset` re-initialises.
PENNILOGIC_POSTGRES_PASSWORD=

# --- Redis 7 (Compose service "redis") ------------------------------------------------------
PENNILOGIC_REDIS_HOST=127.0.0.1
PENNILOGIC_REDIS_PORT=6379
PENNILOGIC_REDIS_DATABASE=0
# Blank user and password (the default) mean no authentication on the loopback-only port.
# A password set here is enforced by the server, its health check and scripts/smoke_infra.py.
# This stack configures no Redis ACL users: leave the user blank (or "default").
PENNILOGIC_REDIS_USER=
PENNILOGIC_REDIS_PASSWORD=

# --- Optional -------------------------------------------------------------------------------
# Compose project name (containers, network and volumes are labelled with it). Honoured by
# plain `docker compose` and by scripts/bootstrap.py alike; defaults to the compose file's
# `name: pennilogic`. Tests use their own unique project names and never this one.
# COMPOSE_PROJECT_NAME=pennilogic
